DATABASE_URL=postgresql://postgres:postgres@localhost:5432/script_divider

# ContactBoxTools
CONTACTBOX_API_KEY=
CONTACTBOX_BASE_URL=https://api.contactboxtools.me/v1
CONTACTBOX_MODEL=gpt-5.6-terra

# OpenAI image generation (gpt-image-2)
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_SIZE=1536x1024

# AI still speed (Yellowstone ~180 stills → target <10 min total job)
# Default 16 parallel gpt-image-2. ContactBox per-still engineer OFF (set 1 to enable).
AI_STILL_CONCURRENCY=16
AI_PROMPT_ENGINEER=0

# SearchAPI.io (Google Images)
SEARCHAPI_API_KEY=
# SearchAPI cost estimate (USD per Google query @ dev tier)
SEARCHAPI_USD_PER_QUERY=0.004
GOOGLE_SEARCH_API_KEY=

# Search defaults
SEARCH_ASPECT_RATIO=wide
SEARCH_IMAGE_SIZE=large
SEARCH_SAFE=active
SEARCH_MIN_WIDTH=800
SEARCH_MIN_HEIGHT=450
SEARCH_CONCURRENCY=4

# Per-job visual budget + concurrency
MAX_GOOGLE_QUERIES_PER_JOB=125
MAX_AI_STILLS_PER_JOB=100
GOOGLE_BEATS_PER_QUERY=2
MAX_CONCURRENT_JOBS=3

# gpt-image-2 cost estimates (USD per still @ 1536x1024 low)
GPT_IMAGE2_REALTIME_USD=0.005
GPT_IMAGE2_BATCH_USD=0.0025

# Optional Pexels B-roll (video search)
PEXELS_API_KEY=
