generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  queued
  running
  completed
  failed
}

model Job {
  id             String    @id @default(cuid())
  title          String?
  niche          String    @default("mystery")
  status         JobStatus @default(queued)
  phase          String    @default("google-first")
  script         String
  beatCount      Int       @default(0)
  sceneCount     Int       @default(0)
  googleCount    Int       @default(0)
  aiCount        Int       @default(0)
  model          String?
  error          String?
  progress       String?
  beatsJson      Json?
  resultJson     Json?
  previewsJson   Json?
  scenesJson     Json?
  usageJson      Json?
  previewDone    Boolean   @default(false)
  packageReady   Boolean   @default(false)
  packageUrl     String?
  packageError   String?
  packageJson    Json?
  voiceoverUrl   String?
  voiceoverDurationSec Float?
  imagesOnly     Boolean   @default(true)
  /** When true, AI stills use OpenAI Batch API (~50% cheaper, up to 24h). */
  aiBatch        Boolean   @default(false)
  /** OpenAI batch id while AI Batch job is in flight (resume after restart). */
  aiBatchId      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  startedAt      DateTime?
  completedAt    DateTime?

  @@index([status, createdAt])
  @@index([createdAt])
}
